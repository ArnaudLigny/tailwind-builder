{
    "name": "aligny/tailwind-builder",
    "description": "Composer package to build Tailwind CSS using the standalone CLI binary.",
    "keywords": [
        "tailwindcss",
        "tailwind"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Arnaud Ligny"
        }
    ],
    "require": {
        "php": "^8.1",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/process": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Aligny\\TailwindBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aligny\\TailwindBuilder\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/tailwind-build"
    ],
    "scripts": {
        "tailwind:build": "tailwind-build",
        "test": "phpunit"
    }
}
