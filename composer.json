{
  "name": "aligny/tailwind-builder",
  "description": "Composer package to build Tailwind CSS using the standalone CLI binary.",
  "keywords": [
    "tailwindcss",
    "tailwind"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Arnaud Ligny"
    }
  ],
  "require": {
    "php": "^8.2",
    "symfony/console": "^7.4",
    "symfony/process": "^7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Aligny\\TailwindBuilder\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Aligny\\TailwindBuilder\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/tailwind-builder"
  ],
  "scripts": {
    "tailwind:build": "tailwind-builder",
    "test": "phpunit"
  }
}
